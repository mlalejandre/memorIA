# Copia este fichero a .env y ajusta lo que necesites. Las variables de entorno reales tienen prioridad.
# Todas las variables tienen un valor por defecto razonable: solo cambia lo que haga falta.

# --- Datos ---------------------------------------------------------------------------
# Carpeta donde se guarda la memoria (cartuchos, sesion, backups).
# Por defecto: ./body en un checkout del repo, ~/.hmem si se instala con pip.
# HMEM_HOME=/ruta/a/mis/datos

# --- Servidor LLM (cualquier endpoint OpenAI-compatible: llama-server, vLLM, Ollama...) --
SERVER_IP=127.0.0.1
SERVER_USER=
SERVER_PORT_GPU0=8087          # LTM (memoria larga)
SERVER_PORT_GPU1=8088          # STM + respuestas del agente (puede ser el mismo que GPU0)
SERVER_PORT_GPU2=8089          # embeddings (opcional)
# LLM_LTM_URL=http://127.0.0.1:8087/v1
# LLM_STM_URL=http://127.0.0.1:8088/v1
REMOTE_MODEL_ALIAS=local-model
SERVER_AUTOSTART=0             # 1 = lanzar llama-server si no hay nada escuchando (requiere POSIX)
SERVER_KEEP_ALIVE=0
# REMOTE_MODEL_PATH=/ruta/modelo.gguf
# LLAMA_SERVER_BIN=llama-server
# LLAMA_SERVER_EXTRA=
THINKING=0
REQUEST_TIMEOUT_S=240

# --- Interfaz web ---------------------------------------------------------------------
UI_PORT=8765

# --- Memoria a corto plazo (STM) ------------------------------------------------------
STM_MAX_TOKENS=30000
STM_TRIGGER_RATIO=0.90
STM_TARGET_RATIO=0.60
STM_KEEP_RECENT=6
STM_PROMPT_MODE=retrieval
STM_ANSWER_MAX_TOKENS=4096
STM_TEMPERATURE=0.4

# --- Memoria a largo plazo (LTM) ------------------------------------------------------
MEM_TAU=20                     # constante de tiempo del olvido
MEM_ARCHIVE_BELOW=0.5
MEM_MIN_AGE=10
MEM_ADAPTIVE_DEPTH=1
MEM_MAX_DEPTH=5
MEM_NAV=1                      # navegacion por el arbol
MEM_NAV_LLM=0                  # 1 = el LLM elige ramas (mas lento); 0 = vectorial/lexica
MEM_BEAM=2
MEM_RECALL_EXPAND=1
LTM_DIRECT_RETRIEVAL=1         # 1 = inyecta hechos recuperados sin llamada LLM de sintesis
LTM_INGEST_USER=1
LTM_INGEST_ASSISTANT=0
MEM_BACKUP_EVERY=200
MEM_BACKUP_KEEP=10
EPI_ENABLED=1                  # memoria episodica (transcripcion literal)

# --- Embeddings -----------------------------------------------------------------------
EMB_ENABLED=1
EMB_MODEL_ALIAS=bge-m3
# EMB_MODEL_PATH=/ruta/bge-m3.gguf
EMB_MIN_SIM=0.38
EMB_ABSTAIN_SIM=0.48

# --- Pesos de la fusion RRF por canal --------------------------------------------------
RRF_W_EXACT=0.6
RRF_W_FTS=0.25
RRF_W_EMB=2.5
RRF_W_SEM=0.3
RRF_W_TREE=0.1
RRF_W_SYN=0.3

# --- Sinapsis hebbianas ----------------------------------------------------------------
SYN_ENABLED=1
